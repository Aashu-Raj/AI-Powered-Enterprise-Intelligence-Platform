# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=enterprise_platform
POSTGRES_USER=platform_user
POSTGRES_PASSWORD=changeme_strong_password

# Constructed automatically by settings — do not set manually
# DATABASE_URL=postgresql+asyncpg://platform_user:changeme@localhost:5432/enterprise_platform

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── Qdrant (Vector Store) ────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
# Collection name prefix — each tenant gets: {prefix}_{tenant_id}
QDRANT_COLLECTION_PREFIX=enterprise

# ─── OpenSearch (BM25) ────────────────────────────────────────────────────────
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_USE_SSL=false
# Index name prefix — each tenant gets: {prefix}_{tenant_id}
OPENSEARCH_INDEX_PREFIX=enterprise_docs

# ─── S3 / MinIO (Raw file storage) ───────────────────────────────────────────
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=enterprise-platform
S3_REGION=us-east-1

# ─── LLM ──────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Set to "ollama" to use local open-source model
LLM_PROVIDER=openai
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ─── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ─── Embedding Model ──────────────────────────────────────────────────────────
# Local sentence-transformer model (used when not using OpenAI embeddings)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=32

# ─── Security / Auth ──────────────────────────────────────────────────────────
SECRET_KEY=change_this_to_a_random_secret_key_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
